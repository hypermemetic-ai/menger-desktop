# Rust / Tauri build output
/src-tauri/target/
# Generated by tauri-build on every build (capability schemas); Tauri's
# templates ignore it.
/src-tauri/gen/schemas/
# Never in the repository: the updater's signing key (DIST-5).
*.key
*.key.password
# Never in the repository: the Android release key (DIST-6) — it lives in
# ~/.android-keys and in the ANDROID_KEYSTORE_* secrets.
*.jks
*.keystore
keystore.properties
