{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "menger",
  "identifier": "ai.hypermemetic.menger",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "menger — a plan is a program whose leaves are prose",
    "longDescription": "menger as a desktop app: tickets on this device (menger in-process, on free loopback ports) or a menger server at a URL.",
    "copyright": "Copyright (c) 2026 hypermemetic",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQjJCQ0Y3RjhBQ0U1NzcKUldSMzVhejQ5N3l5cXVrQzVnUGNDSzhqNVJvZVhzWHRSSUVIQVhDc0kwblk1blIvUytZY3ZVa1EK",
      "endpoints": [
        "https://github.com/hypermemetic-ai/menger-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
